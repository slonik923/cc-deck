# ------------------------------------------------------------------------ hook

def cmd_hook(_args):
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    if not isinstance(data, dict) or not data.get("session_id"):
        return
    sid = str(data["session_id"])
    if not re.fullmatch(r"[\w-]+", sid):
        return
    event = data.get("hook_event_name", "")
    path = STATE_DIR / f"{sid}.json"
    state = load_json(path, {})
    prev = state.get("status")
    if (event == state.get("event")
            and event not in ("PostToolUse", "PostToolUseFailure", "PermissionRequest")
            and time.time() - (state.get("ts") or 0) < 1.0):
        return  # same event twice (hooks installed both as a plugin and in settings.json)
    state.update(session_id=sid, event=event, ts=time.time(),
                 cwd=data.get("cwd") or state.get("cwd"),
                 ccdeck={"version": VERSION, "script": str(SCRIPT)})  # lets a running dashboard upgrade itself
    if not pid_alive(state.get("pid"), state.get("pid_start")):
        pid = find_claude_ancestor()
        if pid:
            state["pid"], state["pid_start"] = pid, proc_start_time(pid)

    if event == "SessionStart":
        state["status"] = "idle"
        refresh_stable_copy()
        autostart_daemon()
    elif event == "Stop":
        state["status"] = "stopped"
    elif event in ("UserPromptSubmit", "PostToolUse", "PostToolUseFailure"):
        state["status"] = "working"
        state.pop("message", None)
    elif event == "PermissionRequest":
        state["status"] = "permission"
        state["message"] = f"Claude wants to use {data.get('tool_name') or 'a tool'}"
    elif event == "PermissionDenied":
        state["status"] = "working"
    elif event == "SessionEnd":
        state["status"] = "ended"
        state["end_reason"] = data.get("reason")
    elif event == "Notification":
        ntype = str(data.get("notification_type") or "")
        msg = str(data.get("message") or "")
        state["message"] = msg
        low = f"{ntype} {msg}".lower()
        if "permission" in low:
            state["status"] = "permission"
        elif "elicitation" in low or "question" in low:
            state["status"] = "question"
        elif "idle" in low or "waiting for your input" in low:
            state["status"] = "idle"
        if (state.get("status") != prev and state.get("status") in ("permission", "question")
                and not daemon_running()):
            notify(f"Claude needs you · {short_path(state.get('cwd'))}", msg or ntype, urgent=True, sid=sid)
    save_json(path, state)
    close_requests(sid, event, data)
    if event == "PermissionRequest":
        decision = wait_for_approval(sid, data, state)
        if decision:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest",
                                                     "decision": decision}}))


# ---------------------------------------------------------------- approvals
# A PermissionRequest hook and the terminal dialog answer the same prompt in parallel: the
# dialog shows at once, the first answer wins (measured on Claude Code 2.1.321, see
# docs/plans/2026-11-09-dashboard-approvals.md). So the hook may wait for the dashboard
# without delaying the terminal; any failure here prints nothing and leaves it to the terminal.

APPROVAL_POLL = 0.3


def approvals_enabled():
    env = os.environ.get("CCDECK_APPROVALS")
    if env is not None:
        return env == "1"
    return bool(load_json(CONFIG_FILE, {}).get("approvals"))


def input_hash(tool_name, tool_input):
    blob = json.dumps([tool_name, tool_input], sort_keys=True, separators=(",", ":"), default=str)
    return hashlib.sha256(blob.encode()).hexdigest()


def claude_is_headless():
    pid = find_claude_ancestor()
    argv = proc_cmdline(pid) if pid else []
    return any(a in ("-p", "--print") for a in argv[1:])


def ensure_req_dir():
    REQ_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(DATA_DIR, 0o700)
        os.chmod(REQ_DIR, 0o700)
    except OSError:
        pass


def write_private(path, data):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def open_requests(sid=None):
    out = []
    if not REQ_DIR.is_dir():
        return out
    for p in REQ_DIR.glob("*.json"):
        if p.name.endswith(".answer.json"):
            continue
        r = load_json(p, None)
        if not isinstance(r, dict) or not r.get("id"):
            continue
        if (REQ_DIR / f"{r['id']}.over").exists():
            continue
        if sid is None or r.get("session_id") == sid:
            out.append(r)
    out.sort(key=lambda r: r.get("created", 0))
    return out


def mark_over(req_id, why):
    try:
        (REQ_DIR / f"{req_id}.over").write_text(why)
    except OSError:
        pass


def close_requests(sid, event, data):
    """Other hook events of the session tell us a pending prompt was answered elsewhere."""
    if event in ("PermissionRequest", "Notification", "SessionStart"):
        return
    reqs = open_requests(sid)
    if not reqs:
        return
    if event in ("PostToolUse", "PostToolUseFailure"):
        tool = data.get("tool_name")
        h = input_hash(tool, data.get("tool_input"))
        exact = [r for r in reqs if r.get("input_hash") == h]
        # Fallback when the tool input was normalised: the oldest request for that tool.
        hits = exact or [r for r in reqs if r.get("tool_name") == tool][:1]
        for r in hits:
            mark_over(r["id"], f"{event} (answered in the terminal or by a rule)")
    else:  # UserPromptSubmit, Stop, SessionEnd, PermissionDenied
        for r in reqs:
            mark_over(r["id"], event)


def cleanup_request(req_id):
    for suffix in (".json", ".answer.json", ".over"):
        try:
            (REQ_DIR / f"{req_id}{suffix}").unlink()
        except OSError:
            pass


def valid_decision(answer, req):
    if not isinstance(answer, dict) or answer.get("id") != req["id"]:
        return None
    if answer.get("input_hash") != req["input_hash"]:
        return None
    d = answer.get("decision")
    if not isinstance(d, dict):
        return None
    if d.get("behavior") == "allow":
        return {"behavior": "allow"}
    if d.get("behavior") == "deny":
        out = {"behavior": "deny"}
        if isinstance(d.get("message"), str) and d["message"].strip():
            out["message"] = d["message"].strip()[:2000]
        if d.get("interrupt") is True:
            out["interrupt"] = True
        return out
    return None


def wait_for_approval(sid, data, state):
    """Publish the request and wait for the dashboard's answer. Returns a decision or None."""
    try:
        if not approvals_enabled() or not daemon_running() or claude_is_headless():
            return None
        tool = str(data.get("tool_name") or "")
        h = input_hash(tool, data.get("tool_input"))
        if any(r.get("input_hash") == h and time.time() - r.get("created", 0) < 2
               for r in open_requests(sid)):
            return None  # the same prompt from a second copy of the hooks
        ensure_req_dir()
        req = {
            "id": secrets.token_hex(8), "session_id": sid, "cwd": data.get("cwd"),
            "tool_name": tool, "tool_input": data.get("tool_input"),
            "permission_suggestions": data.get("permission_suggestions"),
            "permission_mode": data.get("permission_mode"),
            "mcp_server": data.get("mcp_server"), "input_hash": h,
            "created": time.time(), "pid": os.getpid(),
        }
        write_private(REQ_DIR / f"{req['id']}.json", req)
    except Exception:
        return None
    wait = float(os.environ.get("CCDECK_APPROVAL_WAIT", HOOK_TIMEOUTS["PermissionRequest"] - 60))
    deadline = time.time() + wait
    last_daemon_ok = time.time()
    try:
        while time.time() < deadline:
            answer = load_json(REQ_DIR / f"{req['id']}.answer.json", None)
            if answer is not None:
                return valid_decision(answer, req)
            if (REQ_DIR / f"{req['id']}.over").exists():
                return None
            if daemon_running():
                last_daemon_ok = time.time()
            elif time.time() - last_daemon_ok > 30:
                return None
            time.sleep(APPROVAL_POLL)
        return None
    except Exception:
        return None
    finally:
        cleanup_request(req["id"])


