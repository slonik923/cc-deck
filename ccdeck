GRAPHICAL_VARS = ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS",
                  "XDG_RUNTIME_DIR", "XDG_CURRENT_DESKTOP")


def desktop_env():
    """Environment with the graphical session's variables (a systemd service may start before them)."""
    env = dict(os.environ)
    if IS_MAC or env.get("DISPLAY") or env.get("WAYLAND_DISPLAY"):
        return env
    try:
        out = subprocess.run(["systemctl", "--user", "show-environment"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return env
    for line in out.splitlines():
        k, _, v = line.partition("=")
        if k in GRAPHICAL_VARS and k not in env:
            env[k] = v
    return env


def applescript_str(text):
    return '"' + str(text).replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ") + '"'


NOTIFY_CHANNELS = ("desktop",)  # one switch per channel in config.json; terminal, app and web go here later


def notify_enabled(channel):
    """CCDECK_NOTIFY=0 turns every channel off; otherwise config.json's notifications.<channel> (default on)."""
    if os.environ.get("CCDECK_NOTIFY", "1") == "0":
        return False
    return load_json(CONFIG_FILE, {}).get("notifications", {}).get(channel, True) is not False


def notify(title, body, urgent=False, sid=None):
    if not notify_enabled("desktop"):
        return
    if IS_MAC:
        script = f"display notification {applescript_str(body[:200])} with title {applescript_str(title[:120])}"
        if urgent:
            script += ' sound name "Glass"'
        try:
            subprocess.Popen(["osascript", "-e", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
        return
    if sid and importlib.util.find_spec("gi"):
        # a detached helper sends it and waits for a click, which goes to the session's tab
        cmd = [sys.executable, str(Path(__file__).resolve()), "notify-click", sid] + (["--urgent"] if urgent else []) + ["--", title, body]
    elif shutil.which("notify-send"):
        cmd = ["notify-send", "-a", "Claude Code", "-i", "utilities-terminal"] + (["-u", "critical"] if urgent else []) + [title, body]
    else:
        return
    try:
        subprocess.Popen(cmd, env=desktop_env(), start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


TERMINALS = [  # (binary, args before the command)
    ("gnome-terminal", ["--"]),
    ("ptyxis", ["--new-window", "--"]),
    ("kgx", ["-e"]),
    ("konsole", ["-e"]),
    ("xfce4-terminal", ["-x"]),
    ("tilix", ["-e"]),
    ("kitty", []),
    ("alacritty", ["-e"]),
    ("x-terminal-emulator", ["-e"]),
    ("xterm", ["-e"]),
]


def mac_terminal_command(cwd, argv, app=None):
    """osascript that opens iTerm (if installed) or Terminal and runs the command in a new window."""
    line = applescript_str(f"cd {shlex.quote(cwd)} && {shlex.join(argv)}")
    if app is None:
        app = "iterm" if (Path("/Applications/iTerm.app").exists() or (HOME / "Applications" / "iTerm.app").exists()) else "terminal"
    if app == "iterm":
        return ["osascript", "-e", 'tell application "iTerm"', "-e", "activate",
                "-e", "set w to (create window with default profile)",
                "-e", f"tell current session of w to write text {line}", "-e", "end tell"]
    return ["osascript", "-e", f'tell application "Terminal" to do script {line}',
            "-e", 'tell application "Terminal" to activate']


def terminal_command(cwd, argv):
    custom = os.environ.get("CCDECK_TERMINAL")
    if IS_MAC and (not custom or custom.strip().lower() in ("iterm", "terminal")):
        return mac_terminal_command(cwd, argv, custom.strip().lower() if custom else None)
    script = f"cd {shlex.quote(cwd)} && {shlex.join(argv)}; exec \"${{SHELL:-bash}}\""
    inner = ["bash", "-lc", script]
    candidates = [(shlex.split(custom)[0], shlex.split(custom)[1:])] if custom else TERMINALS
    for binary, pre in candidates:
        if shutil.which(binary):
            return [binary] + pre + inner
    return None


def open_terminal(cwd, argv):
    """Open a new terminal window running argv in cwd; leaves a shell open afterwards."""
    cmd = terminal_command(cwd, argv)
    if not cmd:
        raise RuntimeError("No terminal emulator found; set CCDECK_TERMINAL")
    subprocess.Popen(cmd, cwd=cwd if os.path.isdir(cwd) else None, env=desktop_env(),
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if cmd[0] == "osascript":
        return "iTerm" if 'tell application "iTerm"' in cmd else "Terminal"
    return cmd[0]


def proc_environ(pid):
    try:
        with open(f"/proc/{int(pid)}/environ", "rb") as f:
            return dict(kv.split("=", 1) for kv in f.read().decode(errors="replace").split("\0") if "=" in kv)
    except (OSError, ValueError, TypeError):
        return {}


def proc_tty(pid):
    try:
        tty = subprocess.run(["ps", "-o", "tty=", "-p", str(int(pid))], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        return None
    return "/dev/" + tty if tty and tty not in ("?", "??") else None


def gnome_terminal_window():
    """D-Bus path of any open gnome-terminal window, or None."""
    try:
        out = subprocess.run(["gdbus", "introspect", "--session", "-d", "org.gnome.Terminal", "-o", "/org/gnome/Terminal/window"],
                             capture_output=True, text=True, timeout=5, env=desktop_env()).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"node (\d+)", out)
    return f"/org/gnome/Terminal/window/{m.group(1)}" if m else None


def focus_commands(env, tty, token=None):
    """[(label, [commands...])] that bring the terminal tab of a process to the front, best first.
    token: a Wayland activation token (from a notification click), which lets GNOME raise the window."""
    out = []
    pane = env.get("TMUX_PANE")
    if pane and shutil.which("tmux"):
        sock = (env.get("TMUX") or "").split(",")[0]
        tmux = ["tmux"] + (["-S", sock] if sock else [])
        # shortcut: picks the window and pane, but doesn't raise the terminal the tmux client runs in
        # first command: how many clients show the pane's session; 0 (detached) means nobody would see it
        out.append(("tmux", [tmux + ["display-message", "-p", "-t", pane, "#{session_attached}"],
                             tmux + ["select-window", "-t", pane], tmux + ["select-pane", "-t", pane]]))
        return out  # inside tmux, GNOME_TERMINAL_SCREEN is the tmux server's, not this pane's
    m = re.fullmatch(r"/org/gnome/Terminal/screen/([0-9a-f_]{36})", env.get("GNOME_TERMINAL_SCREEN") or "")
    if m and shutil.which("gdbus"):
        # gnome-terminal's GNOME Shell search provider: activating a result switches to that tab, Wayland included
        cmds = []
        win = token and re.fullmatch(r"[\w/.:+=-]+", token) and gnome_terminal_window()
        if win:
            # without the token GNOME says "Terminal is ready" instead of raising the window; a harmless
            # window action carrying it hands it to gnome-terminal for the present that follows
            cmds.append(["gdbus", "call", "--session", "-d", "org.gnome.Terminal", "-o", win, "-m", "org.gtk.Actions.Activate",
                         "--", "find-clear", "[]", f"{{'desktop-startup-id': <'{token}'>, 'activation-token': <'{token}'>}}"])
        out.append(("gnome-terminal", cmds + [["gdbus", "call", "--session", "-d", "org.gnome.Terminal",
                                        "-o", "/org/gnome/Terminal/SearchProvider",
                                        "-m", "org.gnome.Shell.SearchProvider2.ActivateResult",
                                        m.group(1).replace("_", "-"), "[]", "0"]]))
    if IS_MAC and tty:
        t = applescript_str(tty)
        out.append(("iTerm", [["osascript", "-e", 'if application "iTerm" is not running then return "no"',
                               "-e", 'tell application "iTerm"', "-e", "repeat with w in windows",
                               "-e", "repeat with t in tabs of w", "-e", "repeat with s in sessions of t",
                               "-e", f"if tty of s is {t} then",
                               "-e", "select w", "-e", "select t", "-e", "select s", "-e", "activate",
                               "-e", 'return "ok"', "-e", "end if",
                               "-e", "end repeat", "-e", "end repeat", "-e", "end repeat", "-e", "end tell",
                               "-e", 'return "no"']]))
        out.append(("Terminal", [["osascript", "-e", 'if application "Terminal" is not running then return "no"',
                                  "-e", 'tell application "Terminal"', "-e", "repeat with w in windows",
                                  "-e", "repeat with t in tabs of w", "-e", f"if tty of t is {t} then",
                                  "-e", "set selected of t to true", "-e", "set index of w to 1", "-e", "activate",
                                  "-e", 'return "ok"', "-e", "end if",
                                  "-e", "end repeat", "-e", "end repeat", "-e", "end tell", "-e", 'return "no"']]))
    return out


def tmux_pane_of_tty(tty):
    """The tmux pane (%N) whose terminal is tty, on the default tmux server; None if there's none."""
    # shortcut: default socket only; without /proc we can't read the process's TMUX to find another server
    if not tty or not shutil.which("tmux"):
        return None
    try:
        out = subprocess.run(["tmux", "list-panes", "-a", "-F", "#{pane_tty} #{pane_id}"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return next((pane for t, _, pane in (line.partition(" ") for line in out.splitlines()) if t == tty), None)


def focus_terminal(pid, token=None):
    """Switch to the terminal tab running pid. Returns the terminal's name, or None if we can't."""
    env = proc_environ(pid) if USE_PROC else {}
    tty = proc_tty(pid) if (IS_MAC or not USE_PROC) else None
    if not USE_PROC and (pane := tmux_pane_of_tty(tty)):
        env = {"TMUX_PANE": pane}  # no /proc to read TMUX_PANE from: the pane that owns the tty
    for label, cmds in focus_commands(env, tty if IS_MAC else None, token):
        try:
            rs = [subprocess.run(c, capture_output=True, text=True, timeout=10, env=desktop_env()) for c in cmds]
        except (OSError, subprocess.SubprocessError):
            continue
        if label == "tmux" and rs[0].stdout.strip() in ("", "0"):
            continue  # detached session: switching succeeds but shows nothing
        if all(r.returncode == 0 for r in rs) and (cmds[0][0] != "osascript" or rs[0].stdout.strip() == "ok"):
            return label
    return None


def notification_click(title, body, urgent):
    """Show a desktop notification with a default action. Returns (clicked, activation token or None).
    GNOME sends the click only to the connection that sent the notification (so not `gdbus monitor`),
    and its proxy makes notify-send drop actions, so this holds one connection through PyGObject.
    The token is what lets the terminal raise its window on Wayland."""
    from gi.repository import Gio, GLib  # optional; notify() checks it's there
    bus, loop, state = Gio.bus_get_sync(Gio.BusType.SESSION), GLib.MainLoop(), {"id": None, "clicked": False, "token": None}

    def on_signal(_conn, _sender, _path, _iface, name, params):
        nid, *rest = params.unpack()
        # a click sends ActivationToken, ActionInvoked and NotificationClosed, often in one batch,
        # so Closed may still arrive after quit(): it ends the wait but never undoes a click
        if nid != state["id"]:
            return
        if name == "ActivationToken":
            state["token"] = rest[0]
        elif name == "ActionInvoked" and rest == ["default"]:
            state["clicked"] = True
            loop.quit()
        elif name == "NotificationClosed":
            loop.quit()

    bus.signal_subscribe("org.freedesktop.Notifications", "org.freedesktop.Notifications", None,
                         "/org/freedesktop/Notifications", None, Gio.DBusSignalFlags.NONE, on_signal)
    hints = {"urgency": GLib.Variant("y", 2 if urgent else 1)}
    state["id"] = bus.call_sync(
        "org.freedesktop.Notifications", "/org/freedesktop/Notifications", "org.freedesktop.Notifications", "Notify",
        GLib.Variant("(susssasa{sv}i)", ("Claude Code", 0, "utilities-terminal", title[:120], body[:300],
                                         ["default", "Go to tab"], hints, -1)),
        None, Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
    GLib.timeout_add_seconds(4 * 3600, loop.quit)  # shortcut: a notification left in the tray stops being clickable after 4h
    loop.run()
    return state["clicked"], state["token"]


def cmd_notify_click(args):
    """Detached helper: show the notification and, if it's clicked, go to the session's terminal tab."""
    try:
        clicked, token = notification_click(args.title, args.body, args.urgent)
    except Exception as e:  # GLib.Error, no session bus, …: the notification is lost, say why
        print(f"ccdeck notify-click: {e}", file=sys.stderr)
        return
    if clicked and (peer := peer_sessions().get(args.sid)):
        focus_terminal(peer["pid"], token)


def open_path(target):
    opener = "open" if IS_MAC else "xdg-open"
    if shutil.which(opener):
        subprocess.Popen([opener, target], env=desktop_env(), stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


