USE_PROC = os.path.exists("/proc/self/stat") and os.environ.get("CCDECK_NO_PROC") != "1"  # set to test the macOS path
_ps_cache = {"t": 0.0, "rows": {}}


def parse_ps(text):
    """`ps -axww -o pid=,ppid=,lstart=,command=` output -> {pid: (ppid, start, command)}.

    lstart is five words in the C locale ("Thu Nov 12 17:31:28 2026"); it is the process's
    start time, used like /proc's start ticks to tell a live pid from a reused one."""
    rows = {}
    for line in text.splitlines():
        parts = line.split(None, 7)
        if len(parts) < 7 or not parts[0].isdigit() or not parts[1].isdigit():
            continue
        rows[int(parts[0])] = (int(parts[1]), " ".join(parts[2:7]), parts[7] if len(parts) > 7 else "")
    return rows


def ps_table():
    now = time.time()
    if now - _ps_cache["t"] < 1.0:
        return _ps_cache["rows"]
    try:
        out = subprocess.run(["ps", "-axww", "-o", "pid=,ppid=,lstart=,command="], capture_output=True,
                             text=True, timeout=10, env=dict(os.environ, LC_ALL="C")).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    _ps_cache.update(t=now, rows=parse_ps(out))
    return _ps_cache["rows"]


def _ps_row(pid):
    try:
        return ps_table().get(int(pid))
    except (ValueError, TypeError):
        return None


def _stat_fields(pid):
    with open(f"/proc/{int(pid)}/stat") as f:
        return f.read().rsplit(")", 1)[1].split()


def proc_start_time(pid):
    if not USE_PROC:
        row = _ps_row(pid)
        return row[1] if row else None
    try:
        return _stat_fields(pid)[19]
    except (OSError, IndexError, ValueError, TypeError):
        return None


def proc_ppid(pid):
    if not USE_PROC:
        row = _ps_row(pid)
        return row[0] if row else None
    try:
        return int(_stat_fields(pid)[1])
    except (OSError, IndexError, ValueError, TypeError):
        return None


def proc_cmdline(pid):
    if not USE_PROC:
        row = _ps_row(pid)
        return row[2].split() if row else []
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except (OSError, ValueError, TypeError):
        return []


def is_claude_cmd(argv):
    if not argv:
        return False
    exe = os.path.basename(argv[0])
    if exe == "claude" or "/claude/versions/" in argv[0]:  # native installer keeps versions there
        return True
    return exe.startswith("node") and any(
        "claude-code" in a or a.endswith("/claude") for a in argv[1:])


def find_claude_ancestor():
    pid = os.getppid()
    for _ in range(8):
        if not pid or pid <= 1:
            return None
        if is_claude_cmd(proc_cmdline(pid)):
            return pid
        pid = proc_ppid(pid)
    return None


def pid_alive(pid, start):
    st = proc_start_time(pid) if pid else None
    return st is not None and (start is None or st == start)


def running_claude_processes():
    if not USE_PROC:
        return _running_claude_ps()
    out = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return out
    for name in entries:
        if not name.isdigit():
            continue
        argv = proc_cmdline(name)
        if not is_claude_cmd(argv):
            continue
        try:
            cwd = os.readlink(f"/proc/{name}/cwd")
        except OSError:
            cwd = None
        out.append((int(name), cwd, argv))
    return out


def _running_claude_ps():
    procs = [(pid, row[2].split()) for pid, row in ps_table().items() if is_claude_cmd(row[2].split())]
    cwds = {}
    if procs and shutil.which("lsof"):
        try:
            out = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn", "-p", ",".join(str(p) for p, _ in procs)],
                                 capture_output=True, text=True, timeout=10).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        pid = None
        for line in out.splitlines():
            if line.startswith("p") and line[1:].isdigit():
                pid = int(line[1:])
            elif line.startswith("n") and pid is not None:
                cwds[pid] = line[1:]
    return [(pid, cwds.get(pid), argv) for pid, argv in procs]


