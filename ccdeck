UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")


def resolve(ref, allow_unknown=False):
    if ref.isdigit() and len(ref) < 4:
        listed = load_json(LAST_LIST_FILE, [])
        i = int(ref) - 1
        if 0 <= i < len(listed) and isinstance(listed[i], str):
            ref = listed[i]
    rows = collect(include_all=True, days=10 ** 6)
    hits = [r for r in rows if r["id"].startswith(ref)]
    if not hits and allow_unknown and UUID_RE.fullmatch(ref):
        # e.g. /ccdeck:done in a session whose first prompt isn't saved yet
        return {"id": ref, "title": "this session", "mark": {}}
    if not hits:
        sys.exit(f"No session matches '{ref}'.")
    if len(hits) > 1:
        sys.exit(f"'{ref}' is ambiguous: " + ", ".join(h["id"][:12] for h in hits))
    return hits[0]


