MSG_LIMIT = 8000  # characters of the last message sent to the page


def session_json(s):
    keep = ("id", "display_title", "title", "cwd", "branch", "first_ts", "last_ts", "prompts",
            "last_role", "pending_tool", "pending_input", "links", "files", "alive", "live_source",
            "mark", "pr_details", "state", "group", "label", "hook_message", "peer_name", "peer_open")
    d = {k: s.get(k) for k in keep}
    d["last_text"] = (s.get("last_text") or "")[-MSG_LIMIT:]
    d["last_text_cut"] = len(s.get("last_text") or "") > MSG_LIMIT
    d["last_prompt"] = (s.get("last_prompt") or "")[-1500:]
    d["refs"] = s.get("refs") or []
    d["linear"] = s.get("linear_list") or []
    d["usage"] = s.get("usage") or empty_usage()
    d["sub_usage"] = s.get("sub_usage") or empty_usage()
    d["context"] = s.get("context") or 0
    d["model"] = s.get("model")
    d["context_limit"] = context_limit(s.get("model"), d["context"])
    d["project"] = os.path.basename(s.get("cwd") or "") or "?"
    d["cwd_short"] = short_path(s.get("cwd"))
    return d


class Dashboard:
    def __init__(self, port):
        self.port = port
        self.token = self._token()
        self.lock = threading.Lock()
        self.snapshot = {"sessions": [], "generated": 0}
        self.etag = ""
        self.prev_states = None
        self.wake = threading.Event()

    @staticmethod
    def _token():
        try:
            tok = TOKEN_FILE.read_text().strip()
        except OSError:
            tok = ""
        if not tok:
            tok = secrets.token_urlsafe(24)
            TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
            TOKEN_FILE.write_text(tok)
            os.chmod(TOKEN_FILE, 0o600)
        return tok

    def refresh(self):
        rows = collect(include_all=True, days=10 ** 6)
        sessions = [session_json(s) for s in rows]
        counts = {g: 0 for g, _ in GROUPS}
        for s in sessions:
            counts[s["group"]] += 1
        snap = {
            "version": VERSION, "sessions": sessions, "counts": counts,
            "groups": [{"key": g, "label": l} for g, l in GROUPS],
            "states": {k: {"group": g, "label": l} for k, (g, l) in STATES.items()},
            "gh": bool(shutil.which("gh")), "hooks": hooks_active(),
            "default_days": DEFAULT_DAYS, "port": self.port, "gh_install": GH_INSTALL,
            "reviews": review_requests(sessions),
        }
        etag = hashlib.sha1(json.dumps(snap, sort_keys=True).encode()).hexdigest()[:16]
        snap["generated"] = time.time()
        with self.lock:
            self.snapshot, self.etag = snap, etag
        self._notify_changes(rows)
        return rows

    def _notify_changes(self, rows):
        cur = {r["id"]: r["state"] for r in rows}
        prev, self.prev_states = self.prev_states, cur
        if prev is None:
            return  # first scan after start: don't replay everything
        for r in rows:
            st, before = r["state"], prev.get(r["id"])
            if st == before or st not in NOTIFY_STATES:
                continue
            if st == "idle" and before != "working":
                continue
            body = r.get("hook_message") or one_line(r.get("last_text"), 160)
            notify(f"{STATES[st][1]} · {title_of(r)[:60]}", body, urgent=r["group"] == "needs", sid=r["id"])

    def heartbeat(self):
        try:
            save_json(DAEMON_FILE, {"pid": os.getpid(), "port": self.port, "ts": time.time()})
        except OSError:
            pass

    def scan_loop(self):
        while True:
            self.wake.wait(2)
            self.wake.clear()
            try:
                self.refresh()
                self.heartbeat()
                self.maybe_upgrade()
            except Exception as e:  # keep the daemon alive no matter what
                print(f"scan error: {e!r}", file=sys.stderr)

    def maybe_upgrade(self):
        """Restart into a newer ccdeck that the session hooks report (a plugin update), in place."""
        if time.time() - getattr(self, "_upgrade_checked", 0) < 10:
            return
        self._upgrade_checked = time.time()
        target = newer_install()
        if not target:
            return
        print(f"ccdeck {target[0]} is installed (this is {VERSION}); restarting into {target[1]}", flush=True)
        try:
            DAEMON_FILE.unlink()
        except OSError:
            pass
        os.execv(sys.executable, [sys.executable, target[1], "serve", "--port", str(self.port)])

    def pr_loop(self):
        last_reviews = 0
        while True:
            if time.time() - last_reviews > 300:
                last_reviews = time.time()
                try:
                    items = fetch_review_requests()
                    if items is not None:
                        old = (load_json(REVIEWS_FILE, {}) or {}).get("items")
                        save_json(REVIEWS_FILE, {"fetched": time.time(), "items": items})
                        if items != old:
                            self.wake.set()
                except Exception as e:
                    print(f"review requests error: {e!r}", file=sys.stderr)
            try:
                with self.lock:
                    sessions = self.snapshot["sessions"]
                urls = []
                for s in sessions:
                    if s["group"] != "done" or time.time() - s["last_ts"] < 2 * 86400:
                        urls.extend(p["url"] for p in s["pr_details"])
                if urls and refresh_prs(list(dict.fromkeys(urls))):
                    self.wake.set()
            except Exception as e:
                print(f"pr error: {e!r}", file=sys.stderr)
            time.sleep(20)

    def find(self, sid):
        with self.lock:
            for s in self.snapshot["sessions"]:
                if s["id"] == sid:
                    return s
        return None

    def handle_action(self, body):
        sid, action = body.get("id"), body.get("action")
        s = self.find(sid) if isinstance(sid, str) else None
        if not s:
            return 404, {"error": "unknown session"}
        result = {"ok": True}
        if action in ("done", "undone", "park", "unpark", "note"):
            text = body.get("text")
            apply_action(sid, action, text if isinstance(text, str) else None)
        elif action == "resume" and (peer := peer_sessions().get(sid)):
            # already open: a second `claude --resume` would fork the session, so go to its tab instead
            result["focused"] = focus_terminal(peer["pid"])
            if not result["focused"]:
                return 409, {"error": f"Already open (@{peer.get('name') or sid[:8]}) in a terminal ccdeck can't switch to"}
        elif action == "resume":
            claude = shutil.which("claude") or "claude"
            try:
                result["terminal"] = open_terminal(s["cwd"] or str(HOME), [claude, "--resume", sid])
            except (RuntimeError, OSError) as e:
                return 500, {"error": str(e)}
            if s["mark"].get("done") or s["mark"].get("parked"):
                set_mark(sid, done=None, done_at=None, parked=None, parked_at=None)
        elif action == "open_folder":
            open_path(s["cwd"] or str(HOME))
        elif action == "refresh_prs":
            refresh_prs([p["url"] for p in s["pr_details"]], force=True)
        else:
            return 400, {"error": "unknown action"}
        self.refresh()
        return 200, result

    def make_handler(self):
        dash = self

        class Handler(BaseHTTPRequestHandler):
            server_version = "ccdeck/" + VERSION

            def log_message(self, *a):
                pass

            def _host_ok(self):
                host = (self.headers.get("Host") or "").lower()
                return host in (f"127.0.0.1:{dash.port}", f"localhost:{dash.port}")

            def _send(self, code, body, ctype="application/json", extra=None):
                data = body if isinstance(body, bytes) else json.dumps(body).encode()
                self.send_response(code)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.send_header("Referrer-Policy", "no-referrer")
                for k, v in (extra or {}).items():
                    self.send_header(k, v)
                self.end_headers()
                self.wfile.write(data)

            def do_GET(self):
                if not self._host_ok():
                    return self._send(403, {"error": "bad host"})
                path = urlparse(self.path).path
                if path in ("/", "/index.html"):
                    try:
                        html = (WEB_DIR / "index.html").read_text(encoding="utf-8")
                    except OSError:
                        return self._send(500, {"error": "web/index.html missing"})
                    html = html.replace("__CC_TOKEN__", dash.token).replace("__CC_VERSION__", VERSION)
                    return self._send(200, html.encode(), "text/html; charset=utf-8", {
                        "Content-Security-Policy":
                            "default-src 'self'; script-src 'unsafe-inline'; "
                            "style-src 'self' 'unsafe-inline'; img-src 'self' data:; "
                            "connect-src 'self'; frame-ancestors 'none'"})
                if path == "/ccdeck.css":
                    try:
                        css = (WEB_DIR / "ccdeck.css").read_bytes()
                    except OSError:
                        return self._send(404, {"error": "not found"})
                    return self._send(200, css, "text/css; charset=utf-8")
                if path == "/api/sessions":
                    if self.headers.get("X-CC-Token") != dash.token:
                        return self._send(403, {"error": "bad token"})
                    with dash.lock:
                        snap, etag = dash.snapshot, dash.etag
                    if self.headers.get("If-None-Match") == etag:
                        self.send_response(304)
                        self.send_header("ETag", etag)
                        self.end_headers()
                        return
                    return self._send(200, snap, extra={"ETag": etag})
                if path == "/api/health":
                    return self._send(200, {"ok": True, "version": VERSION})
                self._send(404, {"error": "not found"})

            def do_POST(self):
                if not self._host_ok() or self.headers.get("X-CC-Token") != dash.token:
                    return self._send(403, {"error": "forbidden"})
                if urlparse(self.path).path != "/api/action":
                    return self._send(404, {"error": "not found"})
                try:
                    n = min(int(self.headers.get("Content-Length") or 0), 65536)
                    body = json.loads(self.rfile.read(n) or b"{}")
                    if not isinstance(body, dict):
                        raise ValueError
                except ValueError:
                    return self._send(400, {"error": "bad json"})
                code, resp = dash.handle_action(body)
                self._send(code, resp)

        return Handler

    def serve(self):
        adopt_stable_copy()
        self.refresh()
        self.heartbeat()
        threading.Thread(target=self.scan_loop, daemon=True).start()
        threading.Thread(target=self.pr_loop, daemon=True).start()
        httpd = ThreadingHTTPServer(("127.0.0.1", self.port), self.make_handler())
        httpd.daemon_threads = True
        print(f"ccdeck dashboard on http://localhost:{self.port}", flush=True)
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass
        finally:
            try:
                DAEMON_FILE.unlink()
            except OSError:
                pass


def version_tuple(v):
    try:
        return tuple(int(x) for x in str(v).split("."))
    except ValueError:
        return ()


def newer_install():
    """(version, script) of the newest ccdeck the hooks ran from in the last day, if newer than this one."""
    best = None
    cutoff = time.time() - 86400
    for st in load_states().values():
        c = st.get("ccdeck") if isinstance(st.get("ccdeck"), dict) else None
        if not c or (st.get("ts") or 0) < cutoff:
            continue
        v, script = str(c.get("version") or ""), str(c.get("script") or "")
        if version_tuple(v) > version_tuple(VERSION) and (best is None or version_tuple(v) > version_tuple(best[0])):
            best = (v, script)
    if not best or not os.path.isfile(best[1]):
        return None
    try:  # the file must really be that version (guards against a loop)
        head = Path(best[1]).read_text(encoding="utf-8", errors="replace")[:4000]
    except OSError:
        return None
    m = re.search(r'^VERSION = "([\d.]+)"', head, re.M)
    return best if m and version_tuple(m.group(1)) > version_tuple(VERSION) else None


def adopt_stable_copy():
    """A dashboard started from the plugin's versioned cache copies itself to STABLE_DIR and points an
    installed service there, so the next login doesn't start a deleted or outdated version."""
    if not running_from_plugin() or not service_installed():
        return
    try:
        if stable_version() != VERSION:
            sync_stable_copy()
        stable = str(STABLE_DIR / "ccdeck")
        if PLIST_FILE.exists():
            import plistlib
            with open(PLIST_FILE, "rb") as f:
                pl = plistlib.load(f)
            args = pl.get("ProgramArguments") or []
            if len(args) > 1 and args[1] != stable:
                args[1] = stable
                with open(PLIST_FILE, "wb") as f:
                    plistlib.dump(pl, f)
        if UNIT_FILE.exists():
            text = UNIT_FILE.read_text()
            new = re.sub(r"^(ExecStart=\S+) (\S+) serve", lambda m: f"{m.group(1)} {stable} serve", text, flags=re.M)
            if new != text:
                UNIT_FILE.write_text(new)
                systemctl("daemon-reload")
        link = HOME / ".local" / "bin" / "ccdeck"
        if link.is_symlink() and "/.claude/plugins/" in os.readlink(link):
            link.unlink()
            link.symlink_to(stable)
    except Exception as e:
        print(f"could not move the service to {STABLE_DIR}: {e!r}", file=sys.stderr)


def daemon_running():
    d = load_json(DAEMON_FILE, {})
    return bool(d) and time.time() - (d.get("ts") or 0) < 30 and pid_alive(d.get("pid"), None)


