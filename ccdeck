def format_rows(rows, width, numbered):
    out, current = [], None
    lw = max([len(r["label"]) for r in rows] + [10])
    for s in rows:
        if s["group"] != current:
            current = s["group"]
            out.append("\n" + c(dict(GROUPS)[current].upper(), ANSI[current]) + "\n")
        numbered.append(s["id"])
        proj = short_path(s["cwd"])
        proj = proj if len(proj) <= 28 else "…" + proj[-27:]
        live = c("●", "32") if s["alive"] else dim("○")
        left = (f"{len(numbered):>3} {live} {s['id'][:8]}  {ago(s['last_ts']):>4}  "
                f"{s['label']:<{lw}}  {proj:<28} ")
        badges = []
        for p in s["pr_details"]:
            st = p.get("state") or "?"
            badges.append(f"#{p['number']}:{'draft' if p.get('draft') and st == 'open' else st}")
        for kind, urls in s["links"].items():
            badges.append(f"{kind}×{len(urls)}")
        if s["files"]:
            badges.append(f"files×{len(s['files'])}")
        b = " ".join(badges)
        note = f"  [{s['mark']['note']}]" if s["mark"].get("note") else ""
        room = max(20, width - len(left) - len(b) - 2)
        out.append(left + bold(one_line(title_of(s) + note, room)) + ("  " + dim(b) if b else "") + "\n")
