PR_RE = re.compile(r"https://github\.com/[\w.-]+/[\w.-]+/pull/\d+")
REF_RES = [  # links shown on a session (Linear issues are handled on their own below)
    ("artifact", re.compile(r"https://claude\.ai/(?:code/)?artifacts?/[\w-]+")),
    ("notion", re.compile(r"https://(?:www\.|app\.)?notion\.(?:so|site|com)/[\w./?=&%#-]+")),
    ("figma", re.compile(r"https://(?:www\.)?figma\.com/(?:design|file|board|slides|make)/[\w/-]+")),
    ("gdoc", re.compile(r"https://docs\.google\.com/[\w/.-]+")),
]
LINEAR_URL_RE = re.compile(r"https://linear\.app/([\w-]+)/issue/([A-Za-z][A-Za-z0-9]{0,9}-\d{1,7})(?:/([\w%-]+))?")
ISSUE_KEY_RE = re.compile(r"(?<![\w/.-])([A-Z][A-Z0-9]{1,9})-(\d{1,7})(?![\w-])")
BRANCH_KEY_RE = re.compile(r"(?:^|[/_])([A-Za-z][A-Za-z0-9]{1,9})-(\d{1,7})(?=$|[-_/])")
SOURCE_RANK = {"created": 3, "you": 2, "claude": 1, "tool": 0}  # how a link entered the session


def slug_title(slug):
    words = re.sub(r"[-_]+", " ", unquote(slug or "")).strip()
    return (words[:1].upper() + words[1:])[:120] if words else None


def notion_title(url):
    last = urlparse(url).path.rstrip("/").split("/")[-1]
    m = re.match(r"(.+)-([0-9a-f]{32})$", last)
    return slug_title(m.group(1)) if m else None


def json_objects(text):
    """Every dict inside a JSON tool result (results are often JSON text)."""
    try:
        root = json.loads(text)
    except (ValueError, TypeError):
        return
    stack = [root]
    while stack:
        x = stack.pop()
        if isinstance(x, dict):
            yield x
            stack.extend(x.values())
        elif isinstance(x, list):
            stack.extend(x)
WRITE_TOOLS = {"Write", "Edit", "MultiEdit", "NotebookEdit"}
CREATING_TOOL_HINTS = ("create", "publish", "Artifact", "save_", "push", "Bash:create")
DECISION_RE = re.compile(
    r"\b(should I|shall I|do you want|would you like|want me to|which (?:one|option|approach)"
    r"|your call|please (?:confirm|decide|choose|pick)|let me know (?:which|whether|if you want))\b",
    re.I)


USAGE_KEYS = (("input", "input_tokens"), ("cache_write", "cache_creation_input_tokens"),
              ("cache_read", "cache_read_input_tokens"), ("output", "output_tokens"))
OLD_200K = re.compile(r"claude-(3|haiku-4|opus-4-[015]|opus-4-20|sonnet-4-[05]|sonnet-4-20)")


def empty_usage():
    return {k: 0 for k, _ in USAGE_KEYS}


def add_usage(total, usage):
    for k, src in USAGE_KEYS:
        v = usage.get(src)
        if isinstance(v, int):
            total[k] += v


def context_of(usage):
    return sum(usage.get(k) or 0 for k in
               ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens")
               if isinstance(usage.get(k) or 0, int))


def context_limit(model, used):
    env = os.environ.get("CCDECK_CONTEXT_LIMIT", "")
    if env.isdigit():
        return int(env)
    if model and OLD_200K.match(model) and "[1m]" not in model and used <= 200_000:
        return 200_000
    return 1_000_000


def assistant_usage(e, seen):
    """(usage, model) for an assistant entry the first time its message id is seen."""
    msg = e.get("message")
    if not isinstance(msg, dict) or not isinstance(msg.get("usage"), dict):
        return None, None
    mid = msg.get("id") or e.get("requestId") or e.get("uuid")
    if mid in seen:
        return None, None
    seen.add(mid)
    model = msg.get("model")
    return msg["usage"], (model if isinstance(model, str) and not model.startswith("<") else None)


def parse_usage_only(path):
    total, seen = empty_usage(), set()
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                if '"usage"' not in line:
                    continue
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if isinstance(e, dict) and e.get("type") == "assistant":
                    u, _ = assistant_usage(e, seen)
                    if u:
                        add_usage(total, u)
    except OSError:
        pass
    return total


def block_text(content):
    if isinstance(content, str):
        return content
    parts = []
    for b in content or []:
        if isinstance(b, dict):
            if b.get("type") == "text":
                parts.append(b.get("text", ""))
            elif b.get("type") == "tool_result":
                parts.append(block_text(b.get("content")))
        elif isinstance(b, str):
            parts.append(b)
    return "\n".join(parts)


def message_content(entry):
    msg = entry.get("message")
    return msg.get("content") if isinstance(msg, dict) else None


def is_real_prompt(entry):
    if entry.get("isMeta") or entry.get("isSidechain"):
        return False
    content = message_content(entry)
    if isinstance(content, list) and any(
            isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
        return False
    t = block_text(content).strip()
    return bool(t) and not t.startswith(
        ("<command-", "<local-command", "<system-reminder", "Caveat:", "[Request interrupted"))


def asks_decision(text):
    tail = (text or "").strip()
    if not tail:
        return False
    last_para = tail.split("\n\n")[-1]
    return last_para.rstrip().endswith("?") or bool(DECISION_RE.search(last_para))


def summarize_tool_input(name, inp):
    """A short, human-readable form of what a tool call wants to do (shown while it waits)."""
    try:
        if name == "Bash":
            return str(inp.get("command") or "")[:400] or None
        if name in WRITE_TOOLS or name == "Read":
            return str(inp.get("file_path") or inp.get("notebook_path") or "")[:400] or None
        if name in ("WebFetch", "WebSearch"):
            return str(inp.get("url") or inp.get("query") or "")[:400] or None
        if name == "AskUserQuestion":
            qs = inp.get("questions") or []
            if qs and isinstance(qs[0], dict):
                return str(qs[0].get("question") or "")[:600] or None
            return None
        if name == "ExitPlanMode":
            return str(inp.get("plan") or "")[:2000] or None
        return json.dumps(inp, ensure_ascii=False)[:400] if inp else None
    except (AttributeError, TypeError, ValueError):
        return None


def parse_transcript(path):
    info = {
        "id": path.stem, "cwd": None, "branch": None, "title": None, "ai_title": None,
        "summary": None, "first_prompt": None, "last_prompt": None, "prompts": 0,
        "first_ts": 0.0, "last_ts": 0.0, "last_role": None, "last_text": "",
        "api_error": False, "pending_tool": None, "pending_input": None, "prs": [], "links": {}, "files": [],
        "refs": [], "linear": {}, "issue_keys": [], "usage": empty_usage(), "context": 0, "model": None,
    }
    prs, files, tool_names, pending, pending_inputs = {}, {}, {}, {}, {}
    refs, linear, keys, tool_titles = {}, {}, {}, {}
    seen_msgs = set()

    def note_ref(url, kind, title, source):
        r = refs.get(url)
        start = source == "you" and info["prompts"] == 0  # shared in the prompt that started the session
        if r is None:
            refs[url] = {"url": url, "kind": kind, "title": title or (notion_title(url) if kind == "notion" else None),
                         "source": source, "start": start}
            return
        r["start"] = r.get("start") or start
        if title and not r["title"]:
            r["title"] = title
        if SOURCE_RANK[source] > SOURCE_RANK[r["source"]]:
            r["source"] = source

    def note_issue(key, url, title, source):
        key = key.upper()
        r = linear.setdefault(key, {"key": key, "url": None, "title": None, "source": source, "start": False})
        r["start"] = r["start"] or (source == "you" and info["prompts"] == 0)
        r["url"] = r["url"] or url
        r["title"] = r["title"] or title
        if SOURCE_RANK[source] > SOURCE_RANK[r["source"]]:
            r["source"] = source

    def add_refs(text, source, with_prs=False):
        if not text:
            return
        if with_prs:
            for m in PR_RE.findall(text):
                if prs.get(m) != "created":
                    prs[m] = source
        for kind, rx in REF_RES:
            for m in rx.findall(text):
                note_ref(m.rstrip(").,;:]'\"`"), kind, None, source)
        for ws, key, slug in LINEAR_URL_RE.findall(text):
            note_issue(key, f"https://linear.app/{ws}/issue/{key.upper()}", slug_title(slug) if slug else None, source)
        if source in ("you", "claude"):
            for a, b in ISSUE_KEY_RE.findall(text):
                keys.setdefault(f"{a}-{b}", None)

    def add_json_titles(text, source):
        for o in json_objects(text):
            url = o.get("url") or o.get("link") or o.get("href")
            title = o.get("title") or o.get("name")
            ident = o.get("identifier")
            title = title if isinstance(title, str) else None
            if isinstance(ident, str) and ISSUE_KEY_RE.fullmatch(ident.upper()):
                note_issue(ident, url if isinstance(url, str) and "linear.app" in url else None, title, source)
            elif isinstance(url, str) and title:
                for kind, rx in REF_RES:
                    if rx.match(url):
                        note_ref(url, kind, title, source)

    try:
        f = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return info
    with f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if not isinstance(e, dict):
                continue
            t = e.get("type")
            if t == "custom-title":
                info["title"] = e.get("customTitle") or info["title"]
                continue
            if t == "ai-title":
                info["ai_title"] = e.get("aiTitle") or info["ai_title"]
                continue
            if t == "summary":
                info["summary"] = e.get("summary") or info["summary"]
                continue
            if t not in ("user", "assistant") or e.get("isSidechain"):
                continue
            ts = parse_ts(e.get("timestamp"))
            if ts:
                info["first_ts"] = info["first_ts"] or ts
                info["last_ts"] = max(info["last_ts"], ts)
            info["cwd"] = e.get("cwd") or info["cwd"]
            info["branch"] = e.get("gitBranch") or info["branch"]
            content = message_content(e)

            if t == "user":
                if isinstance(content, list):
                    for b in content:
                        if isinstance(b, dict) and b.get("type") == "tool_result":
                            tid = b.get("tool_use_id")
                            pending.pop(tid, None)
                            name = tool_names.get(tid, "")
                            body = block_text(b.get("content"))
                            creating = any(h in name for h in CREATING_TOOL_HINTS)
                            if creating or "linear" in name.lower():
                                src = "created" if creating else "tool"
                                add_refs(body, src, with_prs=creating)
                                add_json_titles(body, src)
                                if tid in tool_titles:  # an Artifact publish: title from its own input
                                    for r in refs.values():
                                        if r["kind"] == "artifact" and not r["title"] and r["url"] in body:
                                            r["title"] = tool_titles[tid]
                if is_real_prompt(e):
                    text = block_text(content)
                    add_refs(text, "you")
                    info["prompts"] += 1
                    info["first_prompt"] = info["first_prompt"] or text
                    info["last_prompt"] = text
                    info["last_role"] = "user"
                    info["last_text"] = text
                    info["api_error"] = False
                continue

            usage, model = assistant_usage(e, seen_msgs)
            if usage:
                add_usage(info["usage"], usage)
                ctx = context_of(usage)
                if ctx:
                    info["context"] = ctx
                info["model"] = model or info["model"]
            if not isinstance(content, list):
                continue
            info["api_error"] = bool(e.get("isApiErrorMessage") or e.get("error"))
            for b in content:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text", "").strip():
                    info["last_role"] = "assistant"
                    info["last_text"] = b["text"]
                    add_refs(b["text"], "claude", with_prs=True)
                elif b.get("type") == "tool_use":
                    name = b.get("name", "")
                    inp = b.get("input") if isinstance(b.get("input"), dict) else {}
                    tool_names[b.get("id")] = name
                    pending[b.get("id")] = name
                    pending_inputs[b.get("id")] = summarize_tool_input(name, inp)
                    info["last_role"] = "tool"
                    if "linear" in name.lower():
                        for v in inp.values():
                            if isinstance(v, str) and ISSUE_KEY_RE.fullmatch(v.upper()):
                                note_issue(v, None, None, "tool")
                    if name == "Artifact" or name.endswith("__create"):
                        t = inp.get("title") or inp.get("name")
                        if isinstance(t, str) and t.strip():
                            tool_titles[b.get("id")] = t.strip()[:120]
                    if name in WRITE_TOOLS:
                        fp = inp.get("file_path") or inp.get("notebook_path")
                        if isinstance(fp, str):
                            files[fp] = None
                    elif name == "Bash":
                        cmd = str(inp.get("command", ""))
                        if "gh pr create" in cmd or "git push" in cmd:
                            tool_names[b.get("id")] = "Bash:create"
    info["pending_tool"] = list(pending.values())[-1] if pending else None
    info["pending_input"] = pending_inputs.get(list(pending)[-1]) if pending else None
    info["prs"] = list(prs)
    info["pr_sources"] = dict(prs)
    for r in refs.values():
        r["primary"] = bool(r.get("start") or r["source"] == "created")
    info["refs"] = list(refs.values())
    info["linear"] = linear
    info["issue_keys"] = [k for k in keys if k not in linear]
    links = {}
    for r in info["refs"]:
        links.setdefault(r["kind"], []).append(r["url"])
    for r in linear.values():
        if r["url"]:
            links.setdefault("linear", []).append(r["url"])
    info["links"] = links
    info["files"] = list(files)
    return info


_scan_lock = threading.Lock()


def scan_transcripts():
    with _scan_lock:
        cache = load_json(CACHE_FILE, {})
        if cache.get("v") != CACHE_VERSION:
            cache = {"v": CACHE_VERSION, "files": {}}
        entries = cache["files"]
        seen, sessions, dirty = set(), {}, False
        if PROJECTS_DIR.is_dir():
            for path in PROJECTS_DIR.glob("*/*.jsonl"):
                try:
                    st = path.stat()
                except OSError:
                    continue
                key = str(path)
                seen.add(key)
                sig = [st.st_mtime, st.st_size]
                hit = entries.get(key)
                if hit and hit.get("sig") == sig:
                    info = hit["info"]
                else:
                    info = parse_transcript(path)
                    entries[key] = {"sig": sig, "info": info}
                    dirty = True
                if info["prompts"] == 0:
                    continue
                prev = sessions.get(info["id"])
                if not prev or info["last_ts"] > prev["last_ts"]:
                    sessions[info["id"]] = dict(info)
            sub_usage = {}
            for path in PROJECTS_DIR.glob("*/*/subagents/*.jsonl"):
                try:
                    st = path.stat()
                except OSError:
                    continue
                key = str(path)
                seen.add(key)
                sig = [st.st_mtime, st.st_size]
                hit = entries.get(key)
                if hit and hit.get("sig") == sig and "usage" in hit:
                    u = hit["usage"]
                else:
                    u = parse_usage_only(path)
                    entries[key] = {"sig": sig, "usage": u}
                    dirty = True
                agg = sub_usage.setdefault(path.parent.parent.name, empty_usage())
                for k in agg:
                    agg[k] += u.get(k, 0)
            for sid, u in sub_usage.items():
                if sid in sessions:
                    sessions[sid]["sub_usage"] = u
        for k in list(entries):
            if k not in seen:
                del entries[k]
                dirty = True
        if dirty:
            try:
                save_json(CACHE_FILE, cache)
            except OSError:
                pass
        return sessions


# ------------------------------------------------------------------- PRs (gh)

_pr_lock = threading.Lock()
FAIL = {"FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "ERROR", "STARTUP_FAILURE"}


def summarize_checks(rollup):
    if not rollup:
        return "none"
    failing = pending = False
    for ch in rollup:
        if not isinstance(ch, dict):
            continue
        concl = (ch.get("conclusion") or "").upper()
        state = (ch.get("state") or "").upper()
        status = (ch.get("status") or "").upper()
        if concl in FAIL or state in ("FAILURE", "ERROR"):
            failing = True
        elif (status and status != "COMPLETED") or state in ("PENDING", "EXPECTED"):
            pending = True
    return "failing" if failing else "pending" if pending else "passing"


def fetch_pr(url):
    if not shutil.which("gh"):
        return {"error": "gh not installed"}
    try:
        r = subprocess.run(
            ["gh", "pr", "view", url, "--json",
             "number,title,state,isDraft,reviewDecision,mergeable,statusCheckRollup,headRefName"],
            capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as e:
        return {"error": str(e)}
    if r.returncode != 0:
        return {"error": one_line(r.stderr, 200) or "gh failed"}
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return {"error": "bad gh output"}
    return {
        "number": d.get("number"), "title": d.get("title"),
        "state": (d.get("state") or "").lower(),  # open | closed | merged
        "draft": bool(d.get("isDraft")),
        "review": (d.get("reviewDecision") or "").lower(),  # approved | changes_requested | review_required
        "mergeable": (d.get("mergeable") or "").lower(),  # mergeable | conflicting | unknown
        "checks": summarize_checks(d.get("statusCheckRollup")),
        "head": d.get("headRefName") or "",
    }


def fetch_review_requests():
    """Open PRs where your review is requested. They aren't tied to a session, so the dashboard
    lists them on their own. Off with CCDECK_REVIEW_REQUESTS=0."""
    if os.environ.get("CCDECK_REVIEW_REQUESTS") == "0" or not shutil.which("gh"):
        return None
    try:
        r = subprocess.run(["gh", "search", "prs", "--review-requested=@me", "--state=open", "--limit", "30",
                            "--json", "number,title,url,repository,author,isDraft,updatedAt"],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    try:
        items = json.loads(r.stdout)
    except ValueError:
        return None
    out = []
    for d in items if isinstance(items, list) else []:
        if not isinstance(d, dict) or not isinstance(d.get("url"), str):
            continue
        repo, author = d.get("repository") or {}, d.get("author") or {}
        out.append({"url": d["url"], "number": d.get("number"), "title": d.get("title") or "",
                    "repo": repo.get("nameWithOwner") or repo.get("name") or "",
                    "author": author.get("login") or "", "draft": bool(d.get("isDraft")),
                    "updated": parse_ts(d.get("updatedAt")) or 0})
    out.sort(key=lambda x: -x["updated"])
    return out


def review_requests(sessions):
    """Cached review requests, less PRs that one of your sessions made."""
    own = {p["url"] for s in sessions for p in s.get("pr_details") or [] if p.get("own")}
    items = (load_json(REVIEWS_FILE, {}) or {}).get("items") or []
    return [r for r in items if r.get("url") not in own]


def pr_cache():
    with _pr_lock:
        return load_json(PR_CACHE_FILE, {})


def refresh_prs(urls, force=False):
    """Refresh stale entries for these PR urls. Returns True if anything changed."""
    cache = pr_cache()
    now, changed, fetched = time.time(), False, {}
    for url in urls:
        ent = cache.get(url) or {}
        data = ent.get("data") or {}
        if data.get("error"):
            ttl = 600
        elif data.get("state") in ("merged", "closed"):
            ttl = 6 * 3600
        elif data.get("checks") == "pending":
            ttl = 60
        else:
            ttl = 180
        if force or now - ent.get("fetched", 0) > ttl:
            new = fetch_pr(url)
            changed = changed or new != data
            fetched[url] = {"fetched": now, "data": new}
    if fetched:
        with _pr_lock:
            merged = load_json(PR_CACHE_FILE, {})
            merged.update(fetched)
            save_json(PR_CACHE_FILE, merged)
    return changed


def pr_info(url, cache):
    m = re.match(r"https://github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)", url)
    base = {"url": url, "repo": m.group(1) if m else "", "number": int(m.group(2)) if m else None}
    data = (cache.get(url) or {}).get("data") or {}
    if data.get("error"):
        base["error"] = data["error"]
    elif data:
        base.update(data)
    return base


def pr_details(s, cache):
    """The session's PRs, its own first: ones it created, or whose branch is the session's branch.
    PRs it only mentioned or looked up are kept, marked as related."""
    out = []
    for u in s.get("prs") or []:
        p = pr_info(u, cache)
        p["source"] = (s.get("pr_sources") or {}).get(u) or "claude"
        p["own"] = p["source"] == "created" or bool(p.get("head") and p["head"] == s.get("branch"))
        out.append(p)
    out.sort(key=lambda p: not p["own"])
    return out


# ----------------------------------------------------------------- classify

def load_states():
    states = {}
    if STATE_DIR.is_dir():
        for p in STATE_DIR.glob("*.json"):
            s = load_json(p, None)
            if isinstance(s, dict) and s.get("session_id"):
                states[s["session_id"]] = s
    return states


def pr_state(prs):
    """Most pressing state derived from this session's PRs, or None."""
    known = [p for p in prs if p.get("state")]
    open_prs = [p for p in known if p["state"] == "open"]
    if open_prs:
        if any(p.get("checks") == "failing" for p in open_prs):
            return "ci_failing"
        if any(p.get("review") == "changes_requested" for p in open_prs):
            return "changes_requested"
        if any(p.get("mergeable") == "conflicting" for p in open_prs):
            return "pr_conflict"
        if any(p.get("checks") == "pending" for p in open_prs):
            return "ci_pending"
        if any(p.get("draft") for p in open_prs):
            return "pr_draft"  # yours to review before anyone else does
        if all(p.get("review") == "approved" for p in open_prs):
            return "pr_approved"
        return "pr_review"  # waiting on reviewers
    if any(p["state"] == "merged" for p in known):
        return "pr_merged"
    return None


def classify(s, hook, alive):
    mark = s.get("mark") or {}
    if mark.get("done"):
        return "done"
    pending = s.get("pending_tool")
    status = (hook or {}).get("status")
    hook_ts = (hook or {}).get("ts") or 0
    if hook and hook_ts + 1 < s.get("last_ts", 0) and status not in ("working", "permission"):
        status = None  # transcript moved on after the last hook event

    if alive:
        if status == "permission":
            return "permission"
        if pending == "AskUserQuestion" or status == "question":
            return "question"
        if pending == "ExitPlanMode":
            return "plan"
        quiet = time.time() - max(hook_ts, s.get("last_ts", 0))
        if status == "working" or (status is None and s.get("last_role") in ("user", "tool")):
            if quiet < (QUIET_AFTER if status == "working" else 120):
                return "working"
            if status is None and pending:
                return "permission"  # no hooks: a tool call is stuck, most likely waiting for approval
            return "quiet"
    else:
        if pending == "AskUserQuestion":
            return "question"
        if pending == "ExitPlanMode":
            return "plan"

    if mark.get("parked"):
        return "parked"
    if s.get("api_error"):
        return "error"
    if s.get("last_role") == "assistant" and asks_decision(s.get("last_text")):
        return "decision"
    prs = pr_state([p for p in s.get("pr_details") or [] if p.get("own", True)])
    if prs == "pr_merged" and not alive:
        return "pr_merged"
    if prs and prs != "pr_merged":
        return prs
    if alive:
        return "idle"
    return "closed_midtask" if s.get("last_role") in ("user", "tool") else "closed"


def resumed_ids(procs):
    """Session ids that running claude processes were started on (`--resume <id>`, `-r <id>`, `--resume=<id>`).
    Only the resume argument counts: an id mentioned in a prompt doesn't make that session open."""
    out = set()
    for _, _, argv in procs:
        for i, a in enumerate(argv):
            if a in ("--resume", "-r") and i + 1 < len(argv):
                out.add(argv[i + 1])
            elif a.startswith("--resume="):
                out.add(a.split("=", 1)[1])
    return out


def peer_sessions():
    """Claude Code's own registry (~/.claude/sessions/<pid>.json): session id -> {name, pid} for live processes.
    The name is what other sessions use to message it (SendMessage / ListAgents)."""
    out = {}
    for f in (CLAUDE_DIR / "sessions").glob("*.json"):
        d = load_json(f, {})
        # procStart is required: without it pid_alive accepts any process that reused the pid
        if isinstance(d, dict) and d.get("sessionId") and d.get("procStart") and pid_alive(d.get("pid"), d["procStart"]):
            out[d["sessionId"]] = {"name": d.get("name"), "pid": d["pid"]}
    return out


def guess_live_sessions(sessions, hooks, procs, resumed):
    """Sessions no hook reports on: N claude processes in a folder => its N most recent sessions
    are taken as open, less the processes hooks or `--resume <id>` already account for."""
    per_cwd = {}
    for pid, cwd, argv in procs:
        if cwd:
            per_cwd[cwd] = per_cwd.get(cwd, 0) + 1
    by_cwd = {}
    for s in sessions.values():
        if s["cwd"] in per_cwd:
            by_cwd.setdefault(s["cwd"], []).append(s)
    live = set()
    for cwd, ss in by_cwd.items():
        n = per_cwd[cwd]
        for s in ss:  # processes already explained
            h = hooks.get(s["id"])
            if (h and h.get("pid") and pid_alive(h["pid"], h.get("pid_start"))) or s["id"] in resumed:
                n -= 1
        rest = sorted((s for s in ss if not (hooks.get(s["id"]) or {}).get("pid") and s["id"] not in resumed),
                      key=lambda s: -s["last_ts"])
        live.update(s["id"] for s in rest[:max(0, n)])
    return live


def resolve_linear(sessions):
    """Turn each session's Linear evidence into a list of issues.

    Team keys and the workspace are learned from every Linear URL or Linear tool result seen in
    any session (plus CCDECK_LINEAR_TEAMS / CCDECK_LINEAR_WORKSPACE). A key that only appears in a
    branch name or in plain text ("ENG-42") counts when its team is one of those, so "UTF-8" is not
    taken for an issue."""
    teams = {t.strip().upper() for t in os.environ.get("CCDECK_LINEAR_TEAMS", "").split(",") if t.strip()}
    workspaces = {}
    for s in sessions.values():
        for r in (s.get("linear") or {}).values():
            teams.add(r["key"].split("-")[0])
            m = LINEAR_URL_RE.match(r.get("url") or "")
            if m:
                workspaces[m.group(1)] = workspaces.get(m.group(1), 0) + 1
    ws = os.environ.get("CCDECK_LINEAR_WORKSPACE") or (max(workspaces, key=workspaces.get) if workspaces else None)
    for s in sessions.values():
        found = {k: dict(v) for k, v in (s.get("linear") or {}).items()}
        primary = None
        for a, b in BRANCH_KEY_RE.findall(s.get("branch") or ""):
            key = f"{a.upper()}-{b}"
            if a.upper() in teams:
                primary = primary or key
                found.setdefault(key, {"key": key, "url": None, "title": None, "source": "branch"})
        for key in s.get("issue_keys") or []:
            if key.split("-")[0] in teams:
                found.setdefault(key, {"key": key, "url": None, "title": None, "source": "claude"})
        out = []
        for key, r in found.items():
            r["url"] = r["url"] or (f"https://linear.app/{ws}/issue/{key}" if ws else None)
            r["primary"] = key == primary or bool(r.get("start")) or r["source"] == "created"
            out.append(r)
        if out and not any(r["primary"] for r in out):
            shared = [r for r in out if r["source"] == "you"]
            if len(shared) == 1:  # the one ticket you pasted is the session's ticket
                shared[0]["primary"] = True
        rank = {"branch": 4, "created": 3, "you": 2, "tool": 1, "claude": 0}
        out.sort(key=lambda r: (not r["primary"], -rank.get(r["source"], 0), r["key"]))
        s["linear_list"] = out


def title_of(s):
    return (s.get("title") or s.get("ai_title") or s.get("summary")
            or one_line(s.get("first_prompt"), 90) or "(untitled)")


def collect(include_all=False, days=DEFAULT_DAYS):
    sessions = scan_transcripts()
    hooks = load_states()
    marks = load_json(MARKS_FILE, {})
    procs = running_claude_processes()
    prc = pr_cache()
    peers = peer_sessions()

    resumed = resumed_ids(procs)
    guessed_live = guess_live_sessions(sessions, hooks, procs, resumed | set(peers))

    resolve_linear(sessions)
    rows, cutoff = [], time.time() - days * 86400
    for sid, s in sessions.items():
        hook = hooks.get(sid)
        if hook and hook.get("pid"):
            # a live `--resume <id>` wins: another process sharing the session may have ended it
            hook_live = pid_alive(hook["pid"], hook.get("pid_start")) and hook.get("status") != "ended"
            alive = hook_live or sid in peers or sid in resumed
            if alive and not hook_live:
                hook = None  # another process resumed it; the ended one's status (e.g. permission) isn't the live one's
            s["live_source"] = "hook"
        else:
            alive = sid in peers or sid in resumed or sid in guessed_live
            s["live_source"] = "guess"
        s["alive"] = alive
        s["peer_name"] = (peers.get(sid) or {}).get("name")
        s["peer_open"] = sid in peers  # open in a terminal Claude Code knows; it may have no name
        s["mark"] = marks.get(sid) or {}
        s["pr_details"] = pr_details(s, prc)
        st = classify(s, hook, alive)
        s["state"] = st
        s["group"], s["label"] = STATES[st]
        s["hook_message"] = (hook or {}).get("message") if st == "permission" else None
        s["display_title"] = title_of(s)
        if not include_all:
            if s["group"] == "done":
                continue
            if st in ("closed", "closed_midtask") and s["last_ts"] < cutoff:
                continue
        rows.append(s)
    rows.sort(key=lambda r: (GROUP_ORDER[r["group"]], -r["last_ts"]))
    return rows


# ------------------------------------------------------------------- marks

def set_mark(sid, **kw):
    marks = load_json(MARKS_FILE, {})
    m = marks.get(sid, {})
    for k, v in kw.items():
        if v is None:
            m.pop(k, None)
        else:
            m[k] = v
    if m:
        marks[sid] = m
    else:
        marks.pop(sid, None)
    save_json(MARKS_FILE, marks)


def apply_action(sid, action, text=None):
    now = time.strftime("%Y-%m-%d %H:%M")
    if action == "done":
        set_mark(sid, done=True, done_at=now, parked=None, parked_at=None)
    elif action == "undone":
        set_mark(sid, done=None, done_at=None)
    elif action == "park":
        set_mark(sid, parked=True, parked_at=now)
    elif action == "unpark":
        set_mark(sid, parked=None, parked_at=None)
    elif action == "note":
        set_mark(sid, note=(text or "").strip()[:500] or None)
    else:
        raise ValueError(action)


