def autostart_daemon(force=False):
    """Start the dashboard in the background if nothing serves it (plugin installs have no service).

    force: asked for explicitly (`ccdeck open`), so CCDECK_AUTOSTART and the retry pause don't apply."""
    if daemon_running():
        return
    if not force and (os.environ.get("CCDECK_AUTOSTART", "1") == "0" or service_installed()):
        return
    import fcntl
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    try:
        lock = open(DATA_DIR / "autostart.lock", "a+")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another hook is starting it right now
    with lock:
        lock.seek(0)
        last = lock.read().strip()
        if not force and last.replace(".", "", 1).isdigit() and time.time() - float(last) < 30:
            return
        lock.seek(0)
        lock.truncate()
        lock.write(str(time.time()))
        lock.flush()
        log = open(DATA_DIR / "serve.log", "ab")
        script = STABLE_DIR / "ccdeck" if running_from_plugin() and (STABLE_DIR / "ccdeck").exists() else SCRIPT
        subprocess.Popen([sys.executable, str(script), "serve", "--port", str(DEFAULT_PORT)],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
                         close_fds=True)


# ------------------------------------------------------------------- install

def running_from_plugin():
    """True when this file is Claude Code's copy of the plugin (a versioned cache folder)."""
    return "/.claude/plugins/" in str(SCRIPT)


def stable_version():
    try:
        return (STABLE_DIR / "VERSION").read_text().strip()
    except OSError:
        return None


def sync_stable_copy():
    """Copy this version of ccdeck to STABLE_DIR, where the command and the service point."""
    STABLE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STABLE_DIR / ".ccdeck.tmp"
    shutil.copy2(SCRIPT, tmp)
    os.chmod(tmp, 0o755)
    os.replace(tmp, STABLE_DIR / "ccdeck")
    web = STABLE_DIR / "web"
    if web.exists():
        shutil.rmtree(web)
    shutil.copytree(WEB_DIR, web)
    (STABLE_DIR / "VERSION").write_text(VERSION + "\n")


def refresh_stable_copy():
    """After a plugin update, bring the stable copy (and a running service) to the new version."""
    try:
        if not running_from_plugin() or not (STABLE_DIR / "ccdeck").exists() or stable_version() == VERSION:
            return
        sync_stable_copy()
        if service_installed():
            restart_service()
    except Exception as e:
        print(f"ccdeck: could not refresh {STABLE_DIR}: {e!r}", file=sys.stderr)


def restart_service():
    if PLIST_FILE.exists():
        r = launchctl("kickstart", "-k", f"gui/{os.getuid()}/{LAUNCHD_LABEL}")
        if r.returncode != 0:
            launchctl("bootstrap", f"gui/{os.getuid()}", str(PLIST_FILE))
    elif UNIT_FILE.exists():
        systemctl("restart", "ccdeck.service")


def hook_command():
    return f"{shlex.quote(str(SCRIPT))} hook"


def is_our_hook(h):
    cmd = h.get("command", "") if isinstance(h, dict) else ""
    return ("ccdeck" in cmd or "cc-sessions" in cmd) and cmd.endswith(" hook")  # cc-sessions: old name


def hooks_installed():
    hooks = load_json(SETTINGS_FILE, {}).get("hooks", {})
    if not isinstance(hooks, dict):
        return False
    return any(is_our_hook(h) for gs in hooks.values() if isinstance(gs, list)
               for g in gs if isinstance(g, dict) for h in g.get("hooks", []))


def hooks_active():
    """Hooks from settings.json, or from the plugin (seen as state files written recently)."""
    if hooks_installed():
        return True
    cutoff = time.time() - 7 * 86400
    try:
        return any(p.stat().st_mtime > cutoff for p in STATE_DIR.glob("*.json"))
    except OSError:
        return False


def load_settings_strict():
    if not SETTINGS_FILE.exists():
        return {}
    try:
        with open(SETTINGS_FILE, encoding="utf-8") as f:
            val = json.load(f)
    except (OSError, ValueError) as e:
        sys.exit(f"Cannot read {SETTINGS_FILE} ({e}); not changing it. Fix the file and retry.")
    if not isinstance(val, dict):
        sys.exit(f"{SETTINGS_FILE} is not a JSON object; not changing it.")
    return val


def strip_our_hooks(settings):
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        return
    for ev in list(hooks):
        if not isinstance(hooks[ev], list):
            continue
        for g in hooks[ev]:
            if isinstance(g, dict):
                g["hooks"] = [h for h in g.get("hooks", []) if not is_our_hook(h)]
        hooks[ev] = [g for g in hooks[ev] if not isinstance(g, dict) or g.get("hooks")]
        if not hooks[ev]:
            del hooks[ev]
    if not hooks:
        settings.pop("hooks", None)


def systemctl(*a):
    try:
        return subprocess.run(["systemctl", "--user", *a], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        return subprocess.CompletedProcess(a, 1, "", str(e))


def service_installed():
    return UNIT_FILE.exists() or PLIST_FILE.exists()


def launchctl(*a):
    try:
        return subprocess.run(["launchctl", *a], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        return subprocess.CompletedProcess(a, 1, "", str(e))


def install_launchd(port):
    import plistlib
    path = os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin")
    extra = [str(HOME / ".local" / "bin"), "/opt/homebrew/bin", "/usr/local/bin"]
    path = ":".join(dict.fromkeys([p for p in extra if p not in path.split(":")] + path.split(":")))
    log = str(DATA_DIR / "serve.log")
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    PLIST_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(PLIST_FILE, "wb") as f:
        plistlib.dump({
            "Label": LAUNCHD_LABEL,
            "ProgramArguments": [sys.executable, str(SCRIPT), "serve", "--port", str(port)],
            "RunAtLoad": True,
            "KeepAlive": {"SuccessfulExit": False},
            "ThrottleInterval": 10,
            "EnvironmentVariables": {"PATH": path, "PYTHONUNBUFFERED": "1"},
            "StandardOutPath": log, "StandardErrorPath": log,
        }, f)
    domain = f"gui/{os.getuid()}"
    launchctl("bootout", f"{domain}/{LAUNCHD_LABEL}")
    r = launchctl("bootstrap", domain, str(PLIST_FILE))
    if r.returncode != 0:  # older macOS
        r = launchctl("load", "-w", str(PLIST_FILE))
    if r.returncode == 0:
        print(f"Background service running: http://localhost:{port}  (launchd agent: starts at login, restarts on failure)")
    else:
        print(f"  Could not load the launchd agent: {(r.stderr or r.stdout).strip()}")
    print(f"  Open the dashboard with `ccdeck open`, or bookmark http://localhost:{port}.")


def install_service(port):
    if IS_MAC:
        return install_launchd(port)
    state = systemctl("is-system-running").stdout.strip()
    if not shutil.which("systemctl") or state in ("", "offline", "unknown"):
        print("  No systemd user session here; run `ccdeck serve` yourself instead.")
        return
    path = os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin")
    local_bin = str(HOME / ".local" / "bin")
    if local_bin not in path.split(":"):
        path = f"{local_bin}:{path}"
    UNIT_FILE.parent.mkdir(parents=True, exist_ok=True)
    UNIT_FILE.write_text(f"""[Unit]
Description=ccdeck: dashboard for Claude Code sessions (http://localhost:{port})

[Service]
ExecStart={sys.executable} {SCRIPT} serve --port {port}
Restart=on-failure
RestartSec=5
Environment="PATH={path}"
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
""")
    systemctl("daemon-reload")
    r = systemctl("enable", "ccdeck.service")
    systemctl("restart", "ccdeck.service")
    if r.returncode == 0:
        print(f"Background service running: http://localhost:{port}  (starts at login, restarts on failure)")
    else:
        print(f"  Could not enable the service: {r.stderr.strip()}")

    DESKTOP_FILE.parent.mkdir(parents=True, exist_ok=True)
    DESKTOP_FILE.write_text(f"""[Desktop Entry]
Type=Application
Name=ccdeck
Comment=Dashboard of your Claude Code sessions
Exec=xdg-open http://localhost:{port}
Icon=utilities-terminal
Terminal=false
Categories=Development;
""")
    print("Added 'ccdeck' to your app launcher.")


def cmd_install(args):
    if running_from_plugin() and not os.environ.get("CCDECK_FROM_PLUGIN"):
        sync_stable_copy()
        print(f"Copied ccdeck {VERSION} to {short_path(STABLE_DIR)}; it is kept up to date when the plugin updates.")
        argv = ["install", "--port", str(args.port)] + (["--no-hooks"] if args.no_hooks else []) \
            + (["--no-service"] if args.no_service else [])
        r = subprocess.run([sys.executable, str(STABLE_DIR / "ccdeck")] + argv,
                           env=dict(os.environ, CCDECK_FROM_PLUGIN="1"))
        sys.exit(r.returncode)
    bindir = HOME / ".local" / "bin"
    bindir.mkdir(parents=True, exist_ok=True)
    link = bindir / "ccdeck"
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(SCRIPT)
    print(f"Linked {short_path(link)} -> {short_path(SCRIPT)}")
    if str(bindir) not in os.environ.get("PATH", "").split(":"):
        if IS_MAC:
            print(f"  note: add {short_path(bindir)} to PATH, e.g. `echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.zprofile`.")
        else:
            print(f"  note: add {short_path(bindir)} to PATH (Ubuntu does this at next login).")

    if not args.no_hooks:
        settings = load_settings_strict()
        if SETTINGS_FILE.exists():
            backup = SETTINGS_FILE.with_suffix(".json.bak-ccdeck")
            shutil.copy2(SETTINGS_FILE, backup)
            print(f"Backed up settings to {short_path(backup)}")
        strip_our_hooks(settings)
        hooks = settings.setdefault("hooks", {})
        for ev in HOOK_EVENTS:
            entry = {"hooks": [{"type": "command", "command": hook_command(),
                                "timeout": HOOK_TIMEOUTS.get(ev, 5)}]}
            if ev in ("PostToolUse", "PostToolUseFailure", "Notification", "PermissionRequest"):
                entry["matcher"] = ""
            hooks.setdefault(ev, []).append(entry)
        save_json(SETTINGS_FILE, settings)
        print(f"Added hooks to {short_path(SETTINGS_FILE)} (sessions started or resumed from now on).")

    if not args.no_service:
        install_service(args.port)
    if not shutil.which("gh"):
        print(f"  Tip: install the GitHub CLI (`{GH_INSTALL}`, then `gh auth login`) for PR states.")


def cmd_uninstall(_args):
    if SETTINGS_FILE.exists():
        settings = load_settings_strict()
        strip_our_hooks(settings)
        save_json(SETTINGS_FILE, settings)
        print(f"Removed hooks from {short_path(SETTINGS_FILE)}.")
    if PLIST_FILE.exists():
        launchctl("bootout", f"gui/{os.getuid()}/{LAUNCHD_LABEL}")
        PLIST_FILE.unlink()
        print("Stopped and removed the launchd agent.")
    if UNIT_FILE.exists():
        systemctl("disable", "--now", "ccdeck.service")
        UNIT_FILE.unlink()
        systemctl("daemon-reload")
        print("Stopped and removed the background service.")
    if DESKTOP_FILE.exists():
        DESKTOP_FILE.unlink()
    link = HOME / ".local" / "bin" / "ccdeck"
    if link.is_symlink():
        link.unlink()
    if (STABLE_DIR / "ccdeck").exists():
        shutil.rmtree(STABLE_DIR, ignore_errors=True)
    print(f"Your marks and notes stay in {short_path(DATA_DIR)}.")


# ----------------------------------------------------------------------- main

def main():
    p = argparse.ArgumentParser(prog="ccdeck", description=__doc__.split("\n\n")[0])
    p.add_argument("-a", "--all", action="store_true", help="include done and old sessions")
    p.add_argument("-d", "--days", type=int, default=DEFAULT_DAYS,
                   help=f"hide closed sessions idle longer than this (default {DEFAULT_DAYS})")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("list", help="list sessions (default)")
    s = sub.add_parser("show", help="details for one session")
    s.add_argument("id")
    s.add_argument("--no-gh", action="store_true", help="don't refresh PR state with gh")
    for name, hlp in (("done", "mark solved"), ("undone", "unmark done"),
                      ("park", "set aside for later"), ("unpark", "un-park")):
        s = sub.add_parser(name, help=hlp)
        s.add_argument("id")
        if name == "done":
            s.add_argument("text", nargs="*", metavar="note")
    s = sub.add_parser("note", help="attach a note (empty clears it)")
    s.add_argument("id")
    s.add_argument("text", nargs="*")
    s = sub.add_parser("resume", help="resume a session in its folder")
    s.add_argument("id")
    s.add_argument("extra", nargs=argparse.REMAINDER)
    for name, hlp in (("serve", "run the dashboard server"), ("open", "open the dashboard")):
        s = sub.add_parser(name, help=hlp)
        s.add_argument("--port", type=int, default=DEFAULT_PORT)
    s = sub.add_parser("install", help="hooks, background service, app launcher")
    s.add_argument("--port", type=int, default=DEFAULT_PORT)
    s.add_argument("--no-hooks", action="store_true")
    s.add_argument("--no-service", action="store_true")
    sub.add_parser("uninstall", help="remove hooks, service and launcher")
    s = sub.add_parser("approvals", help="allow/deny permission prompts from the dashboard (opt-in)")
    s.add_argument("mode", nargs="?", choices=["on", "off", "status"], default="status")
    s = sub.add_parser("notifications", help="turn notifications on or off, all or one channel ("
                       + ", ".join(NOTIFY_CHANNELS) + ")")
    s.add_argument("words", nargs="*", metavar="[CHANNEL] [on|off]")
    sub.add_parser("hook", help=argparse.SUPPRESS)
    s = sub.add_parser("notify-click", help=argparse.SUPPRESS)
    s.add_argument("sid")
    s.add_argument("title")
    s.add_argument("body")
    s.add_argument("--urgent", action="store_true")
    args = p.parse_args()

    handlers = {
        None: cmd_list, "list": cmd_list, "show": cmd_show, "resume": cmd_resume,
        "done": cmd_mark("done"), "undone": cmd_mark("undone"), "park": cmd_mark("park"),
        "unpark": cmd_mark("unpark"), "note": cmd_mark("note"), "serve": cmd_serve,
        "open": cmd_open, "install": cmd_install, "approvals": cmd_approvals, "notifications": cmd_notifications, "uninstall": cmd_uninstall, "hook": cmd_hook,
        "notify-click": cmd_notify_click,
    }
    handlers[args.cmd](args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
